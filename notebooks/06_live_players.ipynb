    "import pandas as pd\n",
    "\n",
    "clean = pd.read_parquet(\"../data/processed/steam_clean.parquet\")\n",
    "tracked = clean.nlargest(100, \"total_reviews\")[[\"appID\", \"name\"]]\n",
    "tracked.to_csv(\"../data/live/tracked_games.csv\", index=False)\n",
    "tracked.head(10)"
